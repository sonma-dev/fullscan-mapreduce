# Application
APP_ENV=
# Required for authenticating requests to this backend; the server cannot start without it.
# Set your own value with at least 32 characters. This is separate from AZURE_OPENAI_API_KEY.
API_KEY=
PORT=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=

# Managed identity
AZURE_CLIENT_ID=

# Specification output
LLM_MAX_OUTPUT_TOKENS=128000

# File chunks
FILE_CHUNK_MAX_PAGES=8
FILE_CHUNK_MAX_SLIDES=8

# Level 1 concurrency: chapter contexts and aggregation batches across all chapters
LLM_MAX_PARALLEL_LEVEL1_REQUESTS=16

# Level 2 concurrency: leaf Map requests across all chapters
LLM_MAX_PARALLEL_LEVEL2_REQUESTS=16

# Approval
LLM_MAX_APPROVAL_ATTEMPTS=8
LLM_MAX_APPROVAL_REVIEW_ATTEMPTS=3

# Intermediate output and resource limits
LLM_INTERMEDIATE_MAX_OUTPUT_TOKENS=64000
LLM_INTERMEDIATE_MAX_BYTES=1048576
LLM_FINAL_MAX_BYTES=1048576
LLM_MAX_QUERY_BYTES=8388608
LLM_AUDIT_MAX_BYTES=16777216

# PDF section sizing
FILE_CHUNK_MAX_ESTIMATED_TOKENS=12000
FILE_CHUNK_PAGE_TOKEN_ESTIMATE=2000

# Chapter aggregation and input budgets
LLM_CHAPTER_BATCH_MAX_BYTES=131072
LLM_MAX_CHAPTER_REDUCE_ROUNDS=8
# Input estimates include prompts and previous specifications.
# Adjust these ceilings to the deployment's context limit, reserving room for output.
LLM_CHAPTER_INPUT_TOKEN_BUDGET=128000
LLM_MAP_INPUT_TOKEN_BUDGET=128000
